@model List<Inscricao>
@{
    ViewData["Title"] = "Inscrições";
    List<Inscricao> inscricoes = Model.OrderByDescending(i => i.DataInscricao).ToList();
}

<header class="cabecalho">
    <div>
        <p class="cabecalho__sobre">Gestão</p>
        <h1 class="cabecalho__titulo">Inscrições</h1>
        <p class="cabecalho__descricao">Quem está inscrito em que aula, da inscrição mais recente para a mais antiga.</p>
    </div>
    <div class="cabecalho__acoes">
        <a class="btn btn-dark" asp-action="Create">
            <svg class="ico" aria-hidden="true"><use href="#i-mais"></use></svg>Nova inscrição
        </a>
    </div>
</header>

<section class="tabela-cartao">
    @if (inscricoes.Count == 0)
    {
        <div class="vazio">
            <div class="vazio__icone"><svg class="ico" aria-hidden="true"><use href="#i-inscricoes"></use></svg></div>
            <h2 class="vazio__titulo">Ainda não há inscrições</h2>
            <p class="vazio__texto">Os clientes podem inscrever-se no painel deles, ou pode inscrevê-los aqui.</p>
            <a class="btn btn-dark" asp-action="Create">
                <svg class="ico" aria-hidden="true"><use href="#i-mais"></use></svg>Nova inscrição
            </a>
        </div>
    }
    else
    {
        <div class="tabela-cartao__barra">
            <label class="pesquisa">
                <span class="visually-hidden">Pesquisar inscrições</span>
                <svg class="ico" aria-hidden="true"><use href="#i-pesquisa"></use></svg>
                <input type="search" class="form-control" placeholder="Pesquisar por cliente ou aula" data-filtro="#tabela-inscricoes" data-contador="#total-inscricoes" />
            </label>
            <span class="texto-3 small"><span id="total-inscricoes" class="num">@inscricoes.Count</span> inscrições</span>
        </div>

        <table class="tabela" id="tabela-inscricoes">
            <thead>
                <tr>
                    <th scope="col">Cliente</th>
                    <th scope="col">Aula</th>
                    <th scope="col">Inscrito em</th>
                    <th scope="col">Estado</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inscricao in inscricoes)
                {
                    <tr>
                        <td class="col-principal">
                            <div class="celula-pessoa">
                                <span class="avatar avatar--sm">@Ui.Iniciais(inscricao.Cliente.Nome)</span>
                                <span class="celula-pessoa__nome">@inscricao.Cliente.Nome</span>
                            </div>
                        </td>
                        <td data-label="Aula">
                            <div>
                                <span class="quando">@inscricao.Aula.Nome</span>
                                <span class="celula-pessoa__extra">@Ui.DiaSemana(inscricao.Aula.DataHoraInicio), @inscricao.Aula.DataHoraInicio.ToString("dd/MM HH:mm")</span>
                            </div>
                        </td>
                        <td data-label="Inscrito em">@inscricao.DataInscricao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Estado"><span class="estado @Ui.ClasseEstado(inscricao.Estado)">@inscricao.Estado</span></td>
                        <td class="col-acoes">
                            <div class="acoes">
                                <a class="btn btn-sm btn-fantasma btn-icone" asp-action="Delete" asp-route-id="@inscricao.Id" title="Apagar">
                                    <svg class="ico" aria-hidden="true"><use href="#i-apagar"></use></svg><span class="visually-hidden">Apagar inscrição de @inscricao.Cliente.Nome</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
